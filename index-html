<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Social Club Store</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #020813;
            -webkit-user-select: none;
            user-select: none;
        }

        /* Sky Background */
        .sky-container {
            position: absolute;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 30% 25%, #004b7a 0%, #01162e 50%, #020813 90%);
            z-index: 1;
        }

        /* Super Compact Top Bar */
        .top-admin-bar {
            position: fixed;
            top: 12px;
            left: 50%;
            transform: translateX(-50%);
            width: auto;
            min-width: 160px;
            max-width: 210px;
            height: 26px;
            background: rgba(2, 18, 44, 0.9);
            border: 1px solid #00d4ff;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 10px;
            z-index: 10;
            backdrop-filter: blur(8px);
            box-shadow: 0 0 8px rgba(0, 212, 255, 0.4);
        }

        .top-admin-bar span {
            color: #ffffff;
            font-size: 9.5px;
            font-weight: 700;
            letter-spacing: 0.8px;
            text-shadow: 0 0 5px #00d4ff;
            white-space: nowrap;
            margin-right: 8px;
        }

        .green-dot {
            width: 8px;
            height: 8px;
            background-color: #00ff66;
            border-radius: 50%;
            box-shadow: 0 0 6px #00ff66, 0 0 12px #00ff66;
            animation: greenPulse 1.5s infinite ease-in-out;
            flex-shrink: 0;
        }

        @keyframes greenPulse {
            0%, 100% { opacity: 0.6; transform: scale(0.9); }
            50% { opacity: 1; transform: scale(1.2); box-shadow: 0 0 10px #00ff66, 0 0 18px #00ff66; }
        }

        /* Realistic Moon */
        .moon {
            position: absolute;
            top: 65px;
            right: 8%;
            width: 95px;
            height: 95px;
            background: radial-gradient(circle at 35% 35%, #ffffff 0%, #e1f5fe 45%, #b0bec5 70%, #455a64 100%);
            border-radius: 50%;
            box-shadow: 
                0 0 25px #ffffff,
                0 0 60px rgba(0, 212, 255, 0.6);
            z-index: 2;
            overflow: hidden;
            pointer-events: none;
        }

        .moon-surface {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: 
                radial-gradient(circle at 50% 60%, rgba(55, 71, 79, 0.25) 0%, transparent 40%),
                radial-gradient(circle at 25% 35%, rgba(38, 50, 56, 0.2) 0%, transparent 30%),
                radial-gradient(circle at 70% 30%, rgba(55, 71, 79, 0.2) 0%, transparent 35%);
            filter: contrast(120%);
        }

        /* Star Field */
        .stars {
            position: absolute;
            width: 100%;
            height: 100%;
            z-index: 2;
        }

        .star {
            position: absolute;
            background: #ffffff;
            border-radius: 50%;
            box-shadow: 0 0 6px #00d4ff;
            animation: twinkle var(--duration) infinite ease-in-out;
        }

        @keyframes twinkle {
            0%, 100% { opacity: 0.3; transform: scale(0.8); }
            50% { opacity: 1; transform: scale(1.4); }
        }

        /* City Night Lights at Bottom */
        .city-lights {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 25vh;
            z-index: 3;
            background: linear-gradient(to top, rgba(0, 180, 256, 0.25) 0%, rgba(1, 15, 35, 0.9) 60%, transparent 100%);
            pointer-events: none;
        }

        .city-skyline {
            position: absolute;
            bottom: 0;
            width: 100%;
            height: 18vh;
            background: linear-gradient(to top, #010a17 80%, transparent 100%);
            box-shadow: 0 -15px 40px rgba(0, 212, 255, 0.35);
        }

        /* Floating Items */
        .floating-container {
            position: absolute;
            width: 100%;
            height: 100%;
            z-index: 99;
            pointer-events: none;
        }

        .float-item {
            position: absolute;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 70px;
            height: 70px;
            background: rgba(0, 174, 255, 0.12);
            border: 1.5px solid rgba(0, 212, 255, 0.5);
            backdrop-filter: blur(8px);
            border-radius: 50%;
            box-shadow: 0 0 18px rgba(0, 212, 255, 0.4);
            animation: floatUp var(--speed) infinite ease-in-out;
            color: #ffffff;
            font-size: 22px;
            pointer-events: auto;
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
        }

        .float-item span {
            font-size: 9px;
            margin-top: 2px;
            color: #80d8ff;
            font-weight: 600;
            pointer-events: none;
        }

        @keyframes floatUp {
            0% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-18px) rotate(4deg); }
            100% { transform: translateY(0px) rotate(0deg); }
        }

        /* Fully Black Secret Screen Input under Notes Icon */
        #secretPinInput {
            position: absolute;
            top: 95px;
            left: 42%;
            transform: translateX(-50%);
            width: 65px;
            height: 24px;
            background: #000000;
            border: 1px solid #111111;
            border-radius: 4px;
            color: #000000;
            font-size: 11px;
            text-align: center;
            outline: none;
            opacity: 0;
            z-index: 999;
            transition: opacity 0.3s ease;
            pointer-events: none;
        }

        #secretPinInput.active {
            opacity: 1;
            pointer-events: auto;
        }

        /* Main Content */
        .main-content {
            position: relative;
            z-index: 10;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            text-align: center;
            padding: 20px;
        }

        .title {
            color: #ffffff;
            font-size: 34px;
            font-weight: 800;
            letter-spacing: 2px;
            text-shadow: 
                0 0 10px #00d4ff,
                0 0 25px #0099ff;
            margin-bottom: 6px;
        }

        .subtitle {
            color: #b3e5fc;
            font-size: 13px;
            margin-bottom: 22px;
            letter-spacing: 1px;
        }

        /* Compact Enter Button */
        .enter-btn {
            padding: 10px 24px;
            font-size: 13px;
            font-weight: 700;
            color: #ffffff;
            background: linear-gradient(135deg, rgba(0, 212, 255, 0.4), rgba(0, 102, 255, 0.2));
            border: 1.5px solid #00d4ff;
            border-radius: 20px;
            backdrop-filter: blur(8px);
            cursor: pointer;
            white-space: nowrap;
            box-shadow: 0 0 15px rgba(0, 212, 255, 0.5);
            transition: all 0.3s ease;
            letter-spacing: 0.8px;
        }

        .enter-btn:hover {
            background: rgba(0, 212, 255, 0.6);
            box-shadow: 0 0 25px rgba(0, 212, 255, 0.8);
            transform: scale(1.05);
        }

        /* Sleek Inline Admin Settings Panel */
        .inline-admin-panel {
            display: none;
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(2, 18, 44, 0.95);
            border: 1.5px solid #00d4ff;
            padding: 15px;
            border-radius: 12px;
            width: 85%;
            max-width: 320px;
            text-align: center;
            box-shadow: 0 0 25px rgba(0, 212, 255, 0.5);
            z-index: 999999;
            backdrop-filter: blur(10px);
        }

        .inline-admin-panel h4 {
            color: #00d4ff;
            font-size: 13px;
            margin-bottom: 8px;
            letter-spacing: 1px;
        }

        .inline-admin-panel label {
            display: block;
            text-align: left;
            font-size: 10px;
            color: #80d8ff;
            margin-top: 6px;
            margin-bottom: 2px;
        }

        .inline-admin-panel input {
            width: 100%;
            padding: 7px;
            background: #010814;
            border: 1px solid #00d4ff;
            border-radius: 5px;
            color: #fff;
            font-size: 12px;
            outline: none;
            text-align: center;
        }

        .admin-action-btns {
            display: flex;
            gap: 6px;
            margin-top: 10px;
        }

        .admin-action-btns button {
            flex: 1;
            padding: 6px;
            border: none;
            border-radius: 4px;
            font-weight: bold;
            font-size: 11px;
            cursor: pointer;
        }

        .save-config-btn {
            background: #00ff66;
            color: #000;
        }

        .close-config-btn {
            background: #ff4444;
            color: #fff;
        }
    </style>
</head>
<body>

    <!-- Sky Background -->
    <div class="sky-container">
        <!-- Super Compact Top Bar -->
        <div class="top-admin-bar">
            <span>MGSML SKY PROJECT</span>
            <div class="green-dot"></div>
        </div>

        <div class="moon">
            <div class="moon-surface"></div>
        </div>
        <div class="stars" id="starField"></div>
        <div class="city-lights"></div>
        <div class="city-skyline"></div>
    </div>

    <!-- Floating Items -->
    <div class="floating-container">
        <div class="float-item" style="top: 18%; right: 12%; --speed: 5.5s;">🎸<span>Guitar</span></div>
        <div class="float-item" style="top: 45%; left: 8%; --speed: 7s;">🎙️<span>Mic</span></div>
        <div class="float-item" style="top: 25%; left: 22%; --speed: 6s;">🥁<span>Drums</span></div>
        <div class="float-item" style="top: 58%; right: 14%; --speed: 7.5s;">🎻<span>Violin</span></div>
        <div class="float-item" style="top: 72%; left: 40%; --speed: 6.2s;">🎧<span>Headphone</span></div>
        
        <!-- Notes Icon Trigger -->
        <div class="float-item" id="notesTrigger" style="top: 15%; left: 42%; --speed: 8s;">🎶<span>Notes</span></div>
        
        <!-- Totally Black Secret PIN Field -->
        <input type="password" id="secretPinInput" maxlength="6" oninput="checkSecretPin(this)">

        <div class="float-item" style="top: 75%; left: 16%; --speed: 6.5s;">💃<span>Dance</span></div>
        <div class="float-item" style="top: 36%; right: 8%; --speed: 5.8s;">🎭<span>Drama</span></div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <h1 class="title">SOCIAL CLUB STORE</h1>
        <p class="subtitle">Step into the Night of Talents</p>
        <button class="enter-btn" onclick="enterClub()">WELCOME TO ENTER</button>
    </div>

    <!-- Sleek Inline Admin Settings Panel -->
    <div class="inline-admin-panel" id="inlineAdminPanel">
        <h4>⚙️ Admin Settings</h4>
        <label>GitHub Page URL</label>
        <input type="text" id="githubLinkInput" placeholder="Paste GitHub Link here">

        <label>Change Secret PIN</label>
        <input type="password" id="newMpinInput" placeholder="Enter new PIN (optional)">

        <div class="admin-action-btns">
            <button class="save-config-btn" onclick="saveAdminSettings()">Save</button>
            <button class="close-config-btn" onclick="closeAdminPanel()">Close</button>
        </div>
    </div>

    <script>
        // Generate Twinkling Stars
        const starField = document.getElementById('starField');
        const starCount = 90;

        for (let i = 0; i < starCount; i++) {
            const star = document.createElement('div');
            star.className = 'star';
            
            const size = Math.random() * 3 + 1;
            const posX = Math.random() * 100;
            const posY = Math.random() * 70;
            const duration = Math.random() * 3 + 2;

            star.style.width = `${size}px`;
            star.style.height = `${size}px`;
            star.style.top = `${posY}%`;
            star.style.left = `${posX}%`;
            star.style.setProperty('--duration', `${duration}s`);

            starField.appendChild(star);
        }

        const notesTrigger = document.getElementById('notesTrigger');
        const secretPinInput = document.getElementById('secretPinInput');

        function toggleSecretInput(e) {
            if (e) {
                e.stopPropagation();
                e.preventDefault();
            }
            if (secretPinInput.classList.contains('active')) {
                secretPinInput.classList.remove('active');
                secretPinInput.blur();
            } else {
                secretPinInput.classList.add('active');
                secretPinInput.focus();
            }
        }

        notesTrigger.addEventListener('click', toggleSecretInput);
        notesTrigger.addEventListener('touchend', toggleSecretInput);

        function checkSecretPin(inputElem) {
            const currentMpin = localStorage.getItem('adminMpin') || '1234';
            if (inputElem.value === currentMpin) {
                inputElem.value = '';
                inputElem.classList.remove('active');
                secretPinInput.blur();

                document.getElementById('inlineAdminPanel').style.display = 'block';
                document.getElementById('githubLinkInput').value = localStorage.getItem('targetUrl') || '';
                document.getElementById('newMpinInput').value = '';
            }
        }

        function closeAdminPanel() {
            document.getElementById('inlineAdminPanel').style.display = 'none';
            secretPinInput.value = '';
            secretPinInput.classList.remove('active');
        }

        function saveAdminSettings() {
            const newUrl = document.getElementById('githubLinkInput').value;
            const newMpin = document.getElementById('newMpinInput').value;

            if (newUrl) {
                localStorage.setItem('targetUrl', newUrl.trim());
            }
            if (newMpin) {
                localStorage.setItem('adminMpin', newMpin.trim());
                alert("GitHub Link & PIN Updated Successfully!");
            } else {
                alert("GitHub Link Saved Successfully!");
            }
            closeAdminPanel();
        }

        function enterClub() {
            const targetUrl = localStorage.getItem('targetUrl');
            if (targetUrl) {
                window.location.href = targetUrl;
            } else {
                alert("Please tap on the 'Notes' icon, enter your PIN, and set your GitHub link first!");
            }
        }
    </script>
</body>
</html>
